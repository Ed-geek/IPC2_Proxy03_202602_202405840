@page
@model ResumenIvaModel
@{ ViewData["Title"] = "Resumen IVA"; }
<h2>Resumen de IVA por Fecha</h2>

<form method="post">
    <label>Fecha:</label> <input asp-for="Fecha" type="date" required />
    <button type="submit">Consultar</button>
</form>

@if (!string.IsNullOrEmpty(Model.Resultado))
{
    <pre class="json-box">@Model.Resultado</pre>
    <canvas id="chart" width="700" height="320"></canvas>
    <button onclick="window.print()">📄 Exportar a PDF</button>

    <script>
        const data = @Html.Raw(Model.GraphJson);
        new Chart(document.getElementById('chart'), {
            type: 'bar',
            data: {
                labels: data.map(x => x.nit),
                datasets: [
                    { label: 'IVA Emitido',  data: data.map(x => x.ivaEmitido),  backgroundColor: 'rgba(54,162,235,0.7)' },
                    { label: 'IVA Recibido', data: data.map(x => x.ivaRecibido), backgroundColor: 'rgba(255,99,132,0.7)' }
                ]
            }
        });
    </script>
}