@page
@model ConsultarModel
@{ ViewData["Title"] = "Consultar"; }
<h2>Consultar Facturas por NIT</h2>

<form method="post">
    <label>NIT:</label> <input asp-for="Nit" required />
    <label>Tipo:</label>
    <select asp-for="Tipo">
        <option value="emitidas">Emitidas</option>
        <option value="recibidas">Recibidas</option>
    </select>
    <label>Inicio:</label> <input asp-for="Inicio" type="date" required />
    <label>Fin:</label>    <input asp-for="Fin" type="date" required />
    <button type="submit">Consultar</button>
</form>

@if (!string.IsNullOrEmpty(Model.Resultado))
{
    <pre class="json-box">@Model.Resultado</pre>
    <button onclick="window.print()">📄 Exportar a PDF</button>
}