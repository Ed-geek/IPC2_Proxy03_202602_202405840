@page
@{ ViewData["Title"] = "Inicio"; }
<h2>Bienvenido al Simulador SAT</h2>
<p>Usa el menú superior para:</p>
<ul>
    <li><b>Enviar Mensaje</b> — cargar un archivo .json de RTU o de DTE.</li>
    <li><b>Consultar</b> — facturas emitidas o recibidas por NIT.</li>
    <li><b>Resumen IVA</b> — IVA emitido/recibido por fecha.</li>
    <li><b>Resumen Rango</b> — valor autorizado por fecha en un rango.</li>
    <li><b>Reporte Rango</b> — estadísticas completas de errores.</li>
</ul>