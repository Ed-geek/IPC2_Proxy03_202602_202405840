<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — SAT Simulator</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header>
        <h1>SAT — Simulador DTE (Carnet 202405840)</h1>
        <nav>
            <a asp-page="/Index">Inicio</a>
            <a asp-page="/EnviarMensaje">Enviar Mensaje</a>
            <a asp-page="/Consultar">Consultar</a>
            <a asp-page="/ResumenIva">Resumen IVA</a>
            <a asp-page="/ResumenRango">Resumen Rango</a>
            <a asp-page="/ReporteRango">Reporte Rango</a>
            <a asp-page="/Ayuda">Ayuda</a>
            <button onclick="resetApi()">Resetear</button>
        </nav>
    </header>
    <main>@RenderBody()</main>
    <script>
        async function resetApi() {
            if (!confirm('¿Reiniciar todo el sistema?')) return;
            try {
                await fetch('http://localhost:5000/api/reset', { method: 'POST' });
                alert('Sistema reiniciado.');
            } catch (e) { alert('Error al reiniciar: ' + e); }
        }
    </script>
</body>
</html>